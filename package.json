{
  "name": "jarvis-cli",
  "version": "0.6.0",
  "description": "Jarvis: 39 sandboxed file/terminal/git/web/wiki tools for your PC, as a command-line program",
  "type": "module",
  "bin": {
    "jarvis": "dist/cli.js"
  },
  "scripts": {
